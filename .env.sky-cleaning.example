# Copy onto the Sky Cleaning server as .env.production (keep VITE_API_URL=/api/v1).
# Put the Sky Cleaning logo in public/ as logo-skc.png (or overwrite logo.png).

VITE_API_URL=/api/v1
VITE_BRAND_NAME=Sky Cleaning
VITE_BRAND_TAGLINE=Operations
VITE_BRAND_MARK=SKC
VITE_BRAND_SLUG=Sky-Cleaning
VITE_BRAND_LOGO=/logo-skc.png
VITE_VOC_PREFIX=SKC
VITE_BRAND_EMAIL_PLACEHOLDER=you@skycleaning.com
# Quote the hex. Unquoted #... is treated as a comment and the color is ignored.
VITE_THEME_COLOR="#1b5a9d"
